{
  "name": "vojeto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Train out, bike back: find stations reachable from home by TER in time for a 9am start, with a cycling route home.",
  "scripts": {
    "ingest": "tsx src/cli.ts ingest",
    "plan": "tsx src/cli.ts plan",
    "forget": "tsx src/cli.ts forget",
    "stations": "tsx src/cli.ts stations",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite build && vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yauzl-promise": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
